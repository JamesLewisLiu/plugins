//DATA//
  profile: DB.FindOne(refid, { collection: 'profile' })

section.section#xg2-profile-admin(data-refid=refid)
  if profile
    h3.title.is-4 GuitarFreaks / DrumMania XG2 Profile
    p.subtitle.is-6 Scores and Skill are read-only. Setting changes take effect the next time the game loads the profile.

    article.message.is-info
      .message-body#xg2-admin-status Loading scores and settings…

    .columns.is-multiline
      .column.is-one-third
        .box
          h4.title.is-5 Player Name
          form#xg2-name-form(method="post" action="/emit/xg2-change-name")
            input(type="hidden" name="refid" value=refid)
            .field
              .control
                input.input(type="text" name="name" value=profile.name maxlength="12" required)
              p.help Up to 12 characters.
            .field
              .control
                button.button.is-primary(type="submit") Save Name

      .column.is-one-third
        .box
          h4.title.is-5 Game Settings
          form#xg2-settings-form(method="post" action="/emit/xg2-change-game-settings")
            fieldset#xg2-settings-fields(disabled)
              input(type="hidden" name="refid" value=refid)
              .field
                label.label(for="xg2-last-mode") Default Mode
                .control
                  .select.is-fullwidth
                    select#xg2-last-mode(name="lastMode" required)
                      option(value="0") Practice
                      option(value="1") Standard
                      option(value="2") Classic
                p.help This mode setting supports safe write-back. Other Custom slots are shown as read-only below.
              .field
                .control
                  button.button.is-primary(type="submit") Save Game Settings

      .column.is-one-third
        .box
          h4.title.is-5 Group Icon
          p#xg2-group-summary Group not loaded yet.
          form#xg2-group-form(method="post" action="/emit/xg2-change-group-icon")
            fieldset#xg2-group-fields(disabled)
              input(type="hidden" name="refid" value=refid)
              .field
                label.label(for="xg2-group-icon") Icon Number
                .control
                  .select.is-fullwidth
                    select#xg2-group-icon(name="icon" required)
                      option(value="0") 0
                      option(value="1") 1
                      option(value="2") 2
                      option(value="3") 3
                      option(value="4") 4
                      option(value="5") 5
                      option(value="6") 6
                      option(value="7") 7
                      option(value="8") 8
                      option(value="9") 9
                p.help#xg2-group-help Only the Group owner can change this setting.
              .field
                .control
                  button.button.is-primary(type="submit") Save Group Icon

    .box
      h4.title.is-5 K32 / K33 Saved Settings
      .table-container
        table.table.is-striped.is-narrow.is-fullwidth
          thead
            tr
              th Game
              th Play count
              th Live Point
              th XG2+ LP
              th Shutter
              th Attack
              th Judge
              th Combo
              th Notes
          tbody#xg2-settings-body
            tr
              td(colspan="9") Loading…

    .box
      h4.title.is-5 Records (Standard / Classic)
      .field.is-grouped.is-grouped-multiline
        .control
          .select
            select#xg2-record-game(disabled)
              option(value="K33") K33 GuitarFreaks
              option(value="K32") K32 DrumMania
        .control
          .select
            select#xg2-record-mode(disabled)
              option(value="standard") XG / Standard
              option(value="classic") Classic
        .control
          span.tag.is-info.is-medium#xg2-record-count 0 records
      .table-container
        table.table.is-striped.is-hoverable.is-narrow.is-fullwidth
          thead
            tr
              th Music ID
              th Song
              th Chart
              th Score
              th Achievement
              th Rank
              th Combo
              th Skill
              th Clear
              th Plays
          tbody#xg2-records-body
            tr
              td(colspan="10") Loading…

    .box
      h4.title.is-5 Skill Breakdown
      p.subtitle.is-6 Standard uses 25 new + 25 old songs; Classic uses 14 new + 36 old + 3 LONG songs.
      .field.is-grouped.is-grouped-multiline
        .control
          .select
            select#xg2-skill-game(disabled)
              option(value="K33") K33 GuitarFreaks
              option(value="K32") K32 DrumMania
        .control
          .select
            select#xg2-skill-mode(disabled)
              option(value="standard") XG / Standard
              option(value="classic") Classic
        .control
          .select
            select#xg2-skill-bucket(disabled)
              option(value="newSongs") New Songs
              option(value="oldSongs") Old Songs
              option#xg2-skill-long-option(value="longSongs" hidden disabled) LONG
      .columns.is-mobile.is-multiline
        .column
          p.heading Displayed Skill
          p.title.is-5#xg2-skill-total —
        .column
          p.heading#xg2-skill-new-heading New Top 25
          p.title.is-5#xg2-skill-new —
        .column
          p.heading#xg2-skill-old-heading Old Top 25
          p.title.is-5#xg2-skill-old —
        .column#xg2-skill-long-column(hidden)
          p.heading#xg2-skill-long-heading LONG Top 3
          p.title.is-5#xg2-skill-long —
        .column
          p.heading All point
          p.title.is-5#xg2-skill-all —
      .table-container
        table.table.is-striped.is-hoverable.is-narrow.is-fullwidth
          thead
            tr
              th Bucket Rank
              th Music ID
              th Song
              th Best Chart
              th Skill
              th#xg2-skill-selected-heading Top 25
          tbody#xg2-skill-body
            tr
              td(colspan="6") Loading…

    script(src="static/js/profile_name.js")
  else
    article.message.is-warning
      .message-body This card does not have a GuitarFreaks / DrumMania XG2 profile.
